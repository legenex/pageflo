{
  "name": "legenex-legalos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "dev:turbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "lint:tokens": "node scripts/lint-brand-tokens.mjs",
    "check:buildlog": "node --experimental-strip-types scripts/check-buildlog-coverage.ts",
    "check:handbook": "node --experimental-strip-types scripts/check-handbook-routes.ts",
    "test:brand": "node --experimental-strip-types scripts/test-brand-extract.ts",
    "test:authz": "tsx scripts/test-authz.ts",
    "test:registry": "tsx scripts/test-template-registry.mts",
    "test:slots": "tsx scripts/test-lp-slots.mts",
    "test:dom": "tsx scripts/test-render-dom.mts",
    "test:publish": "tsx scripts/test-publish.mts",
    "test:ai": "tsx scripts/test-ai-content.mts",
    "test:flow": "tsx scripts/test-quiz-flow.mts",
    "test:webhook": "tsx scripts/test-quiz-webhook.mts",
    "test:observability": "tsx scripts/test-observability.mts",
    "test:brand-identity": "tsx scripts/test-brand-identity.mts",
    "test:isolation": "tsx scripts/test-tenant-isolation.mts",
    "test:bootstrap": "cross-env NODE_ENV=production tsx scripts/test-fresh-bootstrap.mts",
    "test:release": "tsx scripts/test-release-ordering.mts",
    "verify:schema": "cross-env NODE_ENV=production tsx scripts/verify-schema.mts",
    "test": "pnpm test:brand && pnpm test:authz && pnpm test:registry && pnpm test:slots && pnpm test:publish && pnpm test:ai && pnpm test:flow && pnpm test:webhook && pnpm test:observability && pnpm test:brand-identity",
    "test:all": "pnpm test && pnpm test:isolation && pnpm test:bootstrap",
    "sweep:templates": "tsx scripts/sweep-templates.mts",
    "reconcile:lp-quiz": "tsx scripts/reconcile-lp-quiz-bindings.mts",
    "extract:lp": "tsx scripts/extract-lp-templates.mjs",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.1",
    "@payloadcms/db-postgres": "3.83.0",
    "@payloadcms/next": "3.83.0",
    "@payloadcms/plugin-multi-tenant": "3.83.0",
    "@payloadcms/richtext-lexical": "3.83.0",
    "@payloadcms/ui": "3.83.0",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "cross-env": "^7.0.3",
    "domhandler": "^5.0.3",
    "dotenv": "^16.4.7",
    "graphql": "^16.10.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.469.0",
    "next": "15.4.11",
    "payload": "3.83.0",
    "playwright": "1.62.1",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "sharp": "0.33.5",
    "undici": "^6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "8.20.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.11",
    "pg": "8.20.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}

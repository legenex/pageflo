# --- Core ---
DATABASE_URI=postgres://legalos:legalos@localhost:5432/legalos
PAYLOAD_SECRET=replace-with-a-long-random-string
NEXT_PUBLIC_SERVER_URL=https://os.legenex.com
LEGALOS_FALLBACK_HOST=os.legenex.com

# --- Super admin (used by seed script only) ---
SUPER_ADMIN_EMAIL=team@legenex.com
SUPER_ADMIN_PASSWORD=change-me-on-first-login

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI ---
ANTHROPIC_API_KEY=

# --- Email (Resend or SMTP, optional) ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@legenex.com
SMTP_FROM_NAME=Legenex

# --- HLR phone enrichment (optional) ---
HLR_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# --- Plesk REST API (used to provision tenant domains on connect) ---
# Plesk admin API base URL. Default port is 8443 for Plesk on Linux.
PLESK_API_URL=https://your-plesk-host:8443
# Generate at: Plesk → Tools & Settings → API Keys → Add API Key
PLESK_API_KEY=
# Where Plesk's nginx should reverse-proxy tenant domains. Should point at this app.
PLESK_PROXY_TARGET=http://127.0.0.1:3000
# Plesk reseller / admin login that will own the auto-created tenant domains.
PLESK_OWNER_LOGIN=admin
# Email used for Let's Encrypt registration on tenant domains.
PLESK_OWNER_EMAIL=team@legenex.com
# Public IP of the Plesk server (optional - Plesk uses it as the bind IP for new domains).
PLESK_IP_ADDRESS=
# Plesk serves its API on 8443 with a certificate issued for a hostname, so a
# connection made to the IP above fails verification. The call never leaves the
# host, so skipping verification FOR PLESK CALLS ONLY is the standard same-host
# pattern. Production sets this to true. It must not spread to any other client.
PLESK_INSECURE_SKIP_TLS_VERIFY=false

# --- Error reporting ---
# Where server errors are POSTed, in addition to the process log. LEAVE BLANK
# until a destination has been chosen: with it unset every error is still
# captured as one structured JSON line per event, which journalctl already
# collects and any log drain can parse. The URL goes through the same SSRF
# admission every outbound address does, and the payload is redacted (email,
# phone, SSN, tokens, query strings) before it leaves. See EB-3 in
# docs/external-blockers.md - the remaining step is a decision, not code.
LEGALOS_ERROR_WEBHOOK_URL=

# --- Remote images ---
# Hosts /_next/image may fetch and optimise, comma separated. EMPTY BY DEFAULT,
# and empty is the safe answer: brand artwork renders as a plain <img> that the
# visitor's browser fetches, so this server never fetches a remote image at all.
# This exists only for an operator who deliberately wants Next's optimiser on a
# known CDN. Wildcards, literal addresses and internal names are refused; see
# src/lib/net/image-hosts.mjs. This replaced `hostname: '**'`, which made
# /_next/image an unauthenticated fetch of any host on every tenant domain.
LEGALOS_IMAGE_HOSTS=

# --- Domain system ---
# Preview subdomain pattern: every Site gets {slug}.LEGALOS_PREVIEW_DOMAIN auto-issued.
# Requires *.LEGALOS_PREVIEW_DOMAIN wildcard DNS pointing at the Plesk server IP.
LEGALOS_PREVIEW_DOMAIN=preview.legenex.com

# Hostname tenants point their custom domains at. Should be the app hostname
# (os.legenex.com), which already resolves to the Plesk server.
LEGALOS_CNAME_TARGET=os.legenex.com

# Server IP for tenants who can't CNAME (apex domains on registrars without ALIAS).
LEGALOS_A_TARGET=

# Local-dev escape hatch: when "true", DNS verification can be skipped via a button.
# MUST be false in production.
LEGALOS_DEV_SKIP_DNS=false

# Shared secret that lets out-of-band review/fix agents POST their status to the
# Agent Plan board (/admin/plan) via POST /api/legalos/agent-plan with an
# `x-agent-token` header. Leave blank to disable token auth entirely — a
# super-admin session is then the only way to write status. Code branches on
# emptiness; do not put a placeholder here.
AGENT_PLAN_TOKEN=

# --- Additional origins for Payload's CSRF allowlist ---
# Comma separated. Server actions send an Origin header that must match an entry
# in the allowlist, or Payload's cookie auth returns user = null and the action
# fails as "unauthenticated" with no CSRF-shaped error. Use this to add apex and
# www aliases rather than editing src/payload.config.ts.
LEGALOS_EXTRA_ORIGINS=

# --- Deployment eligibility ---
# When "true", a funnel deployment is refused unless its Domain is eligible
# (active, TLS verified, bound to the deploying Site). Production sets this true.
LEGALOS_ENFORCE_DOMAIN_ELIGIBILITY=true

# --- Build stamp (set by the release, not by hand) ---
# Surfaced in the admin version footer and by /admin/system. Leave blank locally.
LEGALOS_GIT_SHA=
LEGALOS_BUILD_NUMBER=
LEGALOS_BUILD_TIME=

# --- Playwright ---
# Absolute path to a Chromium binary, for the screenshot and fidelity harnesses
# when Playwright's managed download is unavailable. Blank uses the managed one.
LEGALOS_CHROMIUM_PATH=

# --- Buildlog capture (optional) ---
# Credentials the buildlog screenshot capture signs in with. Leave blank to
# disable capture entirely; code branches on emptiness.
BUILDLOG_CAPTURE_EMAIL=
BUILDLOG_CAPTURE_PASSWORD=

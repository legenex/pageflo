# ============================================================================
# PageFlo environment
# ----------------------------------------------------------------------------
# EVERY PAGEFLO_* NAME BELOW HAS A LEGALOS_* PREDECESSOR THAT STILL WORKS.
# src/lib/pageflo/env.ts reads the PageFlo name first and falls back to the
# legacy one, so a host whose .env has not been migrated keeps running
# unchanged. The legacy names are listed beside each key and are documented in
# docs/INFRASTRUCTURE.md under "compatibility identifiers".
#
# Only .env.example may contain placeholder text. A real .env leaves an unknown
# value BLANK, because the code branches on emptiness, never on a placeholder.
# See AGENTS.md invariant 13.
# ============================================================================

# --- Core ---
# The database name, role and password are legacy identifiers that are load
# bearing in production. They are deliberately NOT renamed. See
# docs/INFRASTRUCTURE.md.
DATABASE_URI=postgres://legalos:legalos@localhost:5432/legalos
PAYLOAD_SECRET=replace-with-a-long-random-string

# --- Hosts ---
# The canonical origin of the operator console, absolute and with scheme. Used
# for Payload's serverURL, CSRF, email links and every absolute admin URL.
# Legacy name: NEXT_PUBLIC_SERVER_URL (still read).
PAGEFLO_SERVER_URL=https://app.pageflo.io
NEXT_PUBLIC_SERVER_URL=https://app.pageflo.io

# The public marketing site. Serves the PageFlo product site at / and is never
# resolved against the Domains table. `www.` of this host redirects 308 to it.
PAGEFLO_MARKETING_HOST=pageflo.io

# The operator console and authentication. Also never a tenant host.
PAGEFLO_APP_HOST=app.pageflo.io

# Hosts that served the console before the rebrand, comma separated. They keep
# behaving exactly as they did until the redirect switch below is flipped.
# Legacy name: LEGALOS_FALLBACK_HOST (single host, still read).
PAGEFLO_LEGACY_APP_HOSTS=os.legenex.com

# When "true", every legacy app host permanently redirects to PAGEFLO_APP_HOST.
# Flipped ONLY after the new domain has been verified end to end, because it is
# what removes the rollback path.
PAGEFLO_LEGACY_HOST_REDIRECT=false

# --- Super admin (used by seed script only) ---
SUPER_ADMIN_EMAIL=team@legenex.com
SUPER_ADMIN_PASSWORD=change-me-on-first-login

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- AI ---
ANTHROPIC_API_KEY=

# --- Email (Resend or SMTP, optional) ---
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@legenex.com
SMTP_FROM_NAME=Legenex

# --- HLR phone enrichment (optional) ---
HLR_PROVIDER=plivo
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=

# --- Plesk REST API (used to provision tenant domains on connect) ---
# Plesk admin API base URL. Default port is 8443 for Plesk on Linux.
PLESK_API_URL=https://your-plesk-host:8443
# Generate at: Plesk → Tools & Settings → API Keys → Add API Key
PLESK_API_KEY=
# Where Plesk's nginx should reverse-proxy tenant domains. Should point at this app.
PLESK_PROXY_TARGET=http://127.0.0.1:3000
# Plesk reseller / admin login that will own the auto-created tenant domains.
PLESK_OWNER_LOGIN=admin
# Email used for Let's Encrypt registration on tenant domains.
PLESK_OWNER_EMAIL=team@legenex.com
# Public IP of the Plesk server (optional - Plesk uses it as the bind IP for new domains).
PLESK_IP_ADDRESS=
# Plesk serves its API on 8443 with a certificate issued for a hostname, so a
# connection made to the IP above fails verification. The call never leaves the
# host, so skipping verification FOR PLESK CALLS ONLY is the standard same-host
# pattern. Production sets this to true. It must not spread to any other client.
PLESK_INSECURE_SKIP_TLS_VERIFY=false

# --- Error reporting ---
# Where server errors are POSTed, in addition to the process log. LEAVE BLANK
# until a destination has been chosen: with it unset every error is still
# captured as one structured JSON line per event, which journalctl already
# collects and any log drain can parse. The URL goes through the same SSRF
# admission every outbound address does, and the payload is redacted (email,
# phone, SSN, tokens, query strings) before it leaves. See EB-3 in
# docs/external-blockers.md - the remaining step is a decision, not code.
# Legacy name: LEGALOS_ERROR_WEBHOOK_URL (still read).
PAGEFLO_ERROR_WEBHOOK_URL=

# --- Remote images ---
# Hosts /_next/image may fetch and optimise, comma separated. EMPTY BY DEFAULT,
# and empty is the safe answer: brand artwork renders as a plain <img> that the
# visitor's browser fetches, so this server never fetches a remote image at all.
# This exists only for an operator who deliberately wants Next's optimiser on a
# known CDN. Wildcards, literal addresses and internal names are refused; see
# src/lib/net/image-hosts.mjs. This replaced `hostname: '**'`, which made
# /_next/image an unauthenticated fetch of any host on every tenant domain.
# Legacy name: LEGALOS_IMAGE_HOSTS (still read).
PAGEFLO_IMAGE_HOSTS=

# --- Domain system ---
# Preview subdomain pattern: every Site gets {slug}.PAGEFLO_PREVIEW_DOMAIN
# auto-issued. Requires a wildcard DNS record pointing at the Plesk server IP.
# THIS IS NOT RENAMED TO A PAGEFLO DOMAIN: live preview hosts and their
# certificates are issued under it, and changing it orphans every one of them.
# Legacy name: LEGALOS_PREVIEW_DOMAIN (still read).
PAGEFLO_PREVIEW_DOMAIN=preview.legenex.com

# Hostname tenants point their custom domains at. Any host that resolves to the
# Plesk server works; existing tenants already have CNAMEs at os.legenex.com, so
# it stays the target until they have been migrated.
# Legacy name: LEGALOS_CNAME_TARGET (still read).
PAGEFLO_CNAME_TARGET=os.legenex.com

# Server IP for tenants who can't CNAME (apex domains on registrars without ALIAS).
# Legacy name: LEGALOS_A_TARGET (still read).
PAGEFLO_A_TARGET=

# Local-dev escape hatch: when "true", DNS verification can be skipped via a button.
# MUST be false in production.
# Legacy name: LEGALOS_DEV_SKIP_DNS (still read).
PAGEFLO_DEV_SKIP_DNS=false

# Shared secret that lets out-of-band review/fix agents POST their status to the
# Agent Plan board (/admin/plan) via POST /api/pageflo/agent-plan with an
# `x-agent-token` header. Leave blank to disable token auth entirely — a
# super-admin session is then the only way to write status. Code branches on
# emptiness; do not put a placeholder here.
AGENT_PLAN_TOKEN=

# --- Additional origins for Payload's CSRF allowlist ---
# Comma separated. Server actions send an Origin header that must match an entry
# in the allowlist, or Payload's cookie auth returns user = null and the action
# fails as "unauthenticated" with no CSRF-shaped error. Use this to add apex and
# www aliases rather than editing src/payload.config.ts.
# Legacy name: LEGALOS_EXTRA_ORIGINS (still read).
PAGEFLO_EXTRA_ORIGINS=

# --- Deployment eligibility ---
# When "true", a funnel deployment is refused unless its Domain is eligible
# (active, TLS verified, bound to the deploying Site). Production sets this true.
# Legacy name: LEGALOS_ENFORCE_DOMAIN_ELIGIBILITY (still read).
PAGEFLO_ENFORCE_DOMAIN_ELIGIBILITY=true

# --- Build stamp (set by the release, not by hand) ---
# Surfaced in the admin version footer and by /admin/system. Leave blank locally.
# Legacy names: LEGALOS_GIT_SHA / _BUILD_NUMBER / _BUILD_TIME (still read).
PAGEFLO_GIT_SHA=
PAGEFLO_BUILD_NUMBER=
PAGEFLO_BUILD_TIME=

# --- Playwright ---
# Absolute path to a Chromium binary, for the screenshot and fidelity harnesses
# when Playwright's managed download is unavailable. Blank uses the managed one.
# Legacy name: LEGALOS_CHROMIUM_PATH (still read).
PAGEFLO_CHROMIUM_PATH=

# --- Buildlog capture (optional) ---
# Credentials the buildlog screenshot capture signs in with. Leave blank to
# disable capture entirely; code branches on emptiness.
BUILDLOG_CAPTURE_EMAIL=
BUILDLOG_CAPTURE_PASSWORD=

# --- Legal publication facts (marketing site) ---
# The /privacy route and the marketing footer's legal links DO NOT PUBLISH until
# every value below is set. This is deliberately fail-closed: a privacy policy
# makes binding statements about a real legal entity, and a policy with a gap in
# it is worse than no page. See src/lib/pageflo/legal.ts and docs/HUMAN-GATES.md.
#
# Supplying these is a business decision, not a code change. /admin/system lists
# exactly which of them are still missing.
PAGEFLO_LEGAL_ENTITY=
PAGEFLO_LEGAL_ADDRESS=
PAGEFLO_PRIVACY_CONTACT=
PAGEFLO_LEGAL_JURISDICTION=
# One "Name: purpose" per line.
PAGEFLO_SUBPROCESSORS=
# One "Category: period" per line.
PAGEFLO_DATA_RETENTION=
# ISO date, e.g. 2026-09-01
PAGEFLO_LEGAL_LAST_UPDATED=
